{
  "name": "juv-ksip-softphone",
  "version": "1.7.5",
  "description": "A React WebRTC SIP softphone component for FreePBX/Asterisk with audio/video calls, auto-recording, connection monitoring, and API upload support",
  "type": "module",
  "main": "./dist/juv-ksip-softphone.js",
  "module": "./dist/juv-ksip-softphone.js",
  "exports": {
    ".": {
      "import": "./dist/juv-ksip-softphone.js",
      "require": "./dist/juv-ksip-softphone.umd.js",
      "types": "./index.d.ts"
    },
    "./styles": "./dist/juv-ksip-softphone.css"
  },
  "types": "index.d.ts",
  "files": [
    "dist",
    "index.d.ts"
  ],
  "keywords": [
    "react",
    "sip",
    "softphone",
    "webrtc",
    "freepbx",
    "asterisk",
    "voip",
    "video-call",
    "audio-call"
  ],
  "author": "Kenneth H. Gimpao",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --config vite.lib.config.js",
    "build:cdn": "vite build --config vite.cdn.config.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepublishOnly": "npm run build:lib && npm run build:cdn"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-draggable": ">=4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kitenebie/SoftPhone-FreePBX.git"
  },
  "dependencies": {
    "@juv/codego-react-ui": "^4.0.0",
    "juv-ksip-softphone": "^1.6.9",
    "lucide-react": ">=0.400.0",
    "sip.js": "^0.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-draggable": "^4.5.0",
    "vite": "^8.0.9"
  }
}
